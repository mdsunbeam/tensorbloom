{
  "productName": "TensorBloom",
  "version": "0.1.0",
  "identifier": "com.tensorbloom.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "node scripts/fetch-uv.mjs && npm run dev",
    "beforeBuildCommand": "node scripts/fetch-uv.mjs && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "TensorBloom",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/uv"],
    "createUpdaterArtifacts": true,
    "resources": {
      "../../python/tensorbloom_sidecar.py": "python/tensorbloom_sidecar.py",
      "../../python/tensorbloom_llm.py": "python/tensorbloom_llm.py",
      "../../python/requirements.txt": "python/requirements.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "updater": {
      "pubkey": "REPLACE_WITH_TAURI_UPDATER_PUBLIC_KEY",
      "endpoints": [
        "https://github.com/mdsunbeam/tensorbloom/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
